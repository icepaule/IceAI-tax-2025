# ---- Paperless ----
PAPERLESS_PORT=8010
PAPERLESS_URL=http://127.0.0.1:8010
PAPERLESS_TIME_ZONE=Europe/Berlin
PAPERLESS_SECRET_KEY=change_me_to_a_long_random_string
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change_me
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=change_me

# Optional Paperless API token for direct API read/write
PAPERLESS_API_TOKEN=

# ---- IMAP collector (optional for next step) ----
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_ACCOUNTS_FILE=/config/imap_accounts.yml
IMAP_GMAIL_APP_PASSWORD=
IMAP_ICLOUD_APP_PASSWORD=
IMAP_PROTON_BRIDGE_PASSWORD=
PROTON_BRIDGE_HOST=127.0.0.1
IMAP_FOLDER=INBOX
IMAP_USE_SSL=true
IMAP_SEARCH=SINCE 01-Jan-2025 BEFORE 01-Jan-2026
IMAP_MAX_MESSAGES=400
IMAP_FILTER_REGEX=(rechnung|invoice|bestellung|bestellbest(a|ä)tigung|auftragsbest(a|ä)tigung|quittung|kassenbon|beleg|order confirmation|receipt|tax invoice|amazon|ebay|kleinanzeigen|aliexpress|az-delivery|az delivery)
IMAP_EXCLUDE_REGEX=
IMAP_BODY_FALLBACK_ENABLED=true
IMAP_BODY_MAX_CHARS=120000
IMAP_MARK_SEEN=false
IMAP_TIMEOUT_SECONDS=30

# ---- Ollama ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=180
OCR_LANGS=deu+eng
OCR_PDF_MAX_PAGES=5

# ---- ecoDMS API ----
ECODMS_BASE_URL=https://127.0.0.1:8180/api
ECODMS_USERNAME=
ECODMS_PASSWORD=
ECODMS_SKIP_TLS_VERIFY=true
ECODMS_CLASSIFICATION_PATH=\Steuer\2025\Privat
ECODMS_AUTO_UPLOAD=false
ECODMS_MAINFOLDER_OID=1
ECODMS_DEFAULT_FOLDER_OID=1.7.5
ECODMS_VERSION_CONTROLLED=false

# ---- Tax export ----
TAX_YEAR=2025
DEFAULT_CURRENCY=EUR
EXPORT_FILENAME=steuer_2025_export.csv
UNSICHER_FILENAME=steuer_2025_pruefliste.csv
REFERENCE_2024_PATH=/data/reference

# ---- Steuerbox upload by e-mail ----
STEUERBOX_ENABLED=false
STEUERBOX_EMAIL=<deine-steuerbox-id>@buhl-steuerbox.de
SMTP_HOST=mail.example.com
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=deine-email@example.de
STEUERBOX_SUBJECT_PREFIX=Steuerbeleg 2025

# ---- Status Web UI ----
STATUS_WEB_HOST=0.0.0.0
STATUS_WEB_PORT=8787

# ---- Manual drop (Samba share target) ----
MANUAL_DROP_DIR=/manual-drop
ECODMS_EXPORT_DIR=/data/ecodms-export

# ---- Portal fetcher / noVNC ----
PORTAL_INTERACTIVE_WAIT_SECONDS=240
PORTAL_MAX_PAGES=12
VODAFONE_USERNAME=
VODAFONE_PASSWORD=

# ---- Scanner / paperless-ai ----
PAPERLESS_AI_PORT=3100
